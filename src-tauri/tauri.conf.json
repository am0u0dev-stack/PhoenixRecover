{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoenixRecover",
  "version": "0.3.0",
  "identifier": "com.mlai.phoenixrecover",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhoenixRecover",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "bin/photorec"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/lib/udev/rules.d/99-phoenixrecover.rules": "resources/99-phoenixrecover.rules",
          "/usr/share/polkit-1/actions/com.mlai.phoenixrecover.policy": "resources/com.mlai.phoenixrecover.policy"
        }
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": []
  }
}